# ==============================================================================
# CodeComprehension Configuration Template
# Copy this file to '.env' for local configuration. Never commit '.env' to git!
# ==============================================================================

# Security Settings
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, the application will refuse to start if SECRET_KEY is not set.
SECRET_KEY=

# Server Network Binding
# Secure default: local loopback only. Use 0.0.0.0 only inside container environments.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
FLASK_ENV=development

# Database Settings
DATABASE_PATH=codecomprehension.db

# AI / LLM Configuration
# Supported providers: offline, gemini, openai
DEFAULT_AI_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=10.0

# Code Execution Sandbox Configuration
# Modes:
#   docker           - Dedicated isolated rootless container (recommended for untrusted code)
#   disabled         - Code execution disabled; static review & AST insights remain active
#   local_dev_unsafe - Explicit opt-in for local development testing only
EXECUTION_BACKEND=docker
EXECUTION_TIMEOUT=3.0
MAX_OUTPUT_CHARS=10000

# Request Limits & Rate Limiting
MAX_CODE_LENGTH=50000
MAX_CONTENT_LENGTH=1048576
TRUSTED_PROXIES=0
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_REVIEW=20 per minute
RATELIMIT_EXECUTE=15 per minute
